# Copy to .env (repo root or backend/) and adjust. Never commit .env.
APP_NAME="Bid Draft Agent"
APP_ENV=development
# Path to the rate card JSON. Relative paths resolve from backend/.
RATE_CARD_PATH=data/rate_cards/hvac_rate_card.json

# LLM (Groq). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=medium
# Responses are cached in backend/.cache/llm/. Set to false to always call the API.
LLM_CACHE=true
