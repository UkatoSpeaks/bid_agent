# Copy to .env (repo root or backend/) and adjust. Never commit .env.
APP_NAME="Bid Draft Agent"
APP_ENV=development
# Path to the rate card JSON. Relative paths resolve from backend/.
RATE_CARD_PATH=data/rate_cards/hvac_rate_card.json

# LLM (Groq). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=medium
# Responses are cached in backend/.cache/llm/. Set to false to always call the API.
LLM_CACHE=true

# A line above this share of the subtotal (percent) is flagged HIGH_IMPACT_LINE,
# and blocked if it rests on a production rate assumed by the LLM.
HIGH_IMPACT_LINE_PCT=15

# If the LLM uses no production rate for a line although one matches its
# description with at least this rapidfuzz score (0-100), the line is flagged
# STANDARD_RATE_DECLINED with the rate to apply.
STANDARD_RATE_DECLINED_SCORE=85

# Browser origins allowed to call the API (the frontend), comma separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
